/delete-node/ &boot_partition;
/delete-node/ &slot0_partition;
/delete-node/ &slot1_partition;


/ {
    aliases {
        qmc5883l-dev = &qmc5883l0;   /* alias = qmc5883l-dev -> becomes _ in C macros */
        mpu6050-dev = &mpu6050;
        rtc = &ds3231_rtc;
    };

    chosen {
		zephyr,display = &ssd1306;

        /* Choose CDC ACM for mcumgr */
        zephyr,uart-mcumgr = &cdc_acm_uart0;  /*virtual uart is used for mcumgr, in same way could also be used for console */
	};
};

&i2c0 {                 /*scl = 27 , sda =26 */
    qmc5883l0: qmc5883l@d {      /* node-label : node-name, version update */
        compatible = "qmc5883l,sensor";
        reg = <0x0D>;
    };

    mpu6050: mpu6050@68 {
		compatible = "invensense,mpu6050";
		reg = <0x68>;
		status = "okay";
	};
};

&i2c1 {
    status = "okay";        /* enable the bus,i2c1 SDA= 30, SCL =31*/

   ssd1306: ssd1306@3c {
		compatible = "solomon,ssd1306fb";
		reg = <0x3c>;
		label = "SSD1306";
		width  = <128>;
		height = <64>;
		segment-offset  = <0>;
		page-offset     = <0>;
		display-offset  = <10>;
		multiplex-ratio = <63>;
		segment-remap;
		com-invdir;
        com-sequential;
		prechargep = <0x11>;
	};

    ds3231_mfd: ds3231@68 {
        compatible = "maxim,ds3231-mfd";
        reg = <0x68>;
        status = "okay";

        /* The RTC is now a child of the MFD node */
        ds3231_rtc: rtc {
            compatible = "maxim,ds3231-rtc";
            status = "okay";
            isw-gpios = <&gpio0 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
        };

        /* Optional: Enable the internal temperature sensor */
        ds3231_sensor: sensor {
            compatible = "maxim,ds3231-sensor";
            status = "okay";
        };

    };

};

&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart"; /*cdc acm virtual uart emulate over usb, it has no connection with hardware uart */
		label = "Zephyr USB CDC-ACM";
	};
};

&flash0 {
	partitions {

		ranges;
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			compatible = "zephyr,mapped-partition";  /* CPU mapped address indicate that it is a part of SoC*/
			label = "mcuboot";
			reg = <0x000000000 0x00010000>;
		};

		slot0_partition: partition@10000 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x000010000 0x0000e8000>;
		};
	};
};

/* STEP 2.1 - Add external flash to board conf file */
&mx25r64 {
	partitions {
		compatible = "fixed-partitions";    /*fixed partition used for external flash, it is external to SoC */
		#address-cells = <1>;       /* 1 represents 32-bit address, 2 (64-bit address) */
		#size-cells = <1>;

		slot1_partition: partition@0 {
			label = "image-1";
			reg = <0x000000000 0x0000e8000>;
		};
	};
};



